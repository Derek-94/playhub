{
  "name": "playhub",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "server/modules",
    "sdk",
    "games/*",
    "portal"
  ],
  "scarfSettings": {
    "enabled": false
  },
  "scripts": {
    "server:up": "docker compose -f server/docker-compose.yml up -d",
    "server:restart": "docker compose -f server/docker-compose.yml restart nakama",
    "server:down":"docker compose -f server/docker-compose.yml down",
    "server:logs": "docker compose -f server/docker-compose.yml logs -f nakama",
    "server:ps": "docker compose -f server/docker-compose.yml ps"
  }
}
